NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAIRVOICE_ADMIN_USER=
PAIRVOICE_ADMIN_PASSWORD=
# Generate 32 random bytes and base64 encode them. Never expose this value to the browser.
PAIRVOICE_CREDENTIAL_ENCRYPTION_KEY=
RESEND_API_KEY=
PAIRVOICE_EMAIL_FROM=PairVoice <hello@pairvoice.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects internal lifecycle/outbox workers. Use a long random secret.
PAIRVOICE_INTERNAL_SECRET=
# Optional alternative for scheduled worker invocations.
CRON_SECRET=

# Required on Next.js and Supabase Edge functions. Use the same long random value on both sides.
PAIRVOICE_EDGE_SHARED_SECRET=
